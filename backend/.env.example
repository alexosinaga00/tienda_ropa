# Base de datos
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/fashionstore_dev

# Seguridad
JWT_SECRET_KEY=cambiar-por-un-valor-aleatorio-largo
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (lista separada por comas). En producción agregar el dominio de Vercel:
# CORS_ORIGINS=http://localhost:4200,https://fashionstore.vercel.app
CORS_ORIGINS=http://localhost:4200

# Entorno
# "local" o "production". En Railway SIEMPRE "production" (con "local" se confía en
# X-Forwarded-For falsificable y el flujo de recuperación devuelve el token).
ENVIRONMENT=local

# Cloudinary (subida y transformación de imágenes). El api_secret nunca
# sale del backend: no se expone en ningún endpoint ni se manda al front.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq (búsqueda por voz, paquete inteligencia). Sin esto, /api/v1/ia/voz
# cae directo al fallback de búsqueda por texto plano.
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-20b

# Correo (Brevo, API HTTP): recuperar contraseña. El remitente debe estar VERIFICADO en Brevo (Senders) y es uno
# solo para todas las empresas. Sin clave o sin remitente no se envía nada (en local se entrega `token_dev`).
# El enlace del correo usa FRONTEND_PUBLIC_URL (más abajo): en producción, el dominio de la web.
BREVO_API_KEY=
CORREO_REMITENTE_EMAIL=
CORREO_REMITENTE_NOMBRE=FashionStore
# Solicitudes de recuperación por cuenta (empresa + correo) dentro de la ventana, en segundos.
# RECUPERAR_MAX_SOLICITUDES=3
# RECUPERAR_VENTANA_SEGUNDOS=3600

# Pagos. Secretos HMAC de los webhooks: sin valor, el webhook de esa
# pasarela se rechaza siempre (no hay default en el código). Generar uno
# largo y aleatorio por entorno, p. ej.:
#   python -c "import secrets; print(secrets.token_hex(32))"
LIBELULA_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_SECRET=
# El QR online es simulado: si queda vacío se usa un secreto aleatorio por
# proceso (el backend firma y verifica su propia confirmación).
# QR_ONLINE_WEBHOOK_SECRET=
# Credenciales de una app de PayPal Developer (modo sandbox o live).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Compra de un plan con PayPal: los planes están en Bs, PayPal cobra en USD (tipo de cambio de referencia),
# el plan anual descuenta ese porcentaje, PayPal devuelve al comprador a FRONTEND_PUBLIC_URL (la web) y un
# pedido sin pagar vence a los PEDIDO_EXPIRA_MINUTOS.
TIPO_CAMBIO_BS_POR_USD=6.96
DESCUENTO_ANUAL_PORCENTAJE=20
FRONTEND_PUBLIC_URL=http://localhost:4200
# PayPal guardado (Vault v3) y pedido sin conexión del cliente. Uso declarado del token al guardarlo (si el sandbox lo
# rechaza, probar IMMEDIATE), si el cobro manda stored_credential, límites por cuenta y topes de un pedido.
# PAYPAL_VAULT_USAGE_PATTERN=UNSCHEDULED_POSTPAID
# PAYPAL_VAULT_STORED_CREDENTIAL=false
# PAYPAL_GUARDADO_MAX_POR_VENTANA=10
# PAYPAL_GUARDADO_VENTANA_SEGUNDOS=3600
# PEDIDO_DIFERIDO_MAX_POR_VENTANA=30
# PEDIDO_DIFERIDO_VENTANA_SEGUNDOS=3600
# PEDIDO_DIFERIDO_MAX_LINEAS=30
# PEDIDO_DIFERIDO_MAX_UNIDADES_POR_LINEA=20
# PEDIDO_DIFERIDO_MAX_UNIDADES=100
# PEDIDO_DIFERIDO_MAX_COSTO_ENVIO=500
# Un pedido sin conexión con más de estos días de antigüedad (fecha_pedido) vence; una fecha futura más allá de la
# tolerancia (horas) es inválida.
# PEDIDO_DIFERIDO_MAX_DIAS=7
# PEDIDO_DIFERIDO_TOLERANCIA_FUTURO_HORAS=24
PEDIDO_EXPIRA_MINUTOS=60
# URL pública de ESTE backend (la pantalla de pago QR se arma con ella).
# En Railway: https://<servicio>.up.railway.app
BACKEND_PUBLIC_URL=http://localhost:8000

# Notificaciones push (Firebase Cloud Messaging, API HTTP v1; sin el SDK firebase-admin). El JSON COMPLETO de la cuenta
# de servicio de Firebase (Configuración del proyecto > Cuentas de servicio > Generar clave privada), en UNA línea; de ahí
# sale también el project_id. Es un SECRETO: solo en el entorno, nunca en el repo. Vacío = no se envía ningún push y todo
# lo demás funciona igual. En Railway se pega el contenido del archivo como valor de la variable.
FIREBASE_CREDENCIALES_JSON=
# Dispositivos activos por usuario (al pasar, se desactiva el más antiguo) y altas/bajas de dispositivos por cuenta.
# PUSH_MAX_DISPOSITIVOS_POR_USUARIO=5
# PUSH_DISPOSITIVOS_MAX_POR_VENTANA=30
# PUSH_DISPOSITIVOS_VENTANA_SEGUNDOS=3600

# Token fijo para POST /api/v1/tareas/* (cron externo). Vacío = deshabilitado.
TAREAS_TOKEN=

# Entregas: peso promedio de una prenda (kg) para cotizar el envío.
PESO_PROMEDIO_PRENDA_KG=0.3

# Vertex AI (modo realista del probador). Proyecto de GCP con la Vertex AI
# API habilitada y una cuenta de servicio con rol "Vertex AI User".
# Credenciales: en local, GOOGLE_APPLICATION_CREDENTIALS con la ruta al JSON;
# en Railway, GOOGLE_CREDENTIALS_JSON con el contenido completo del JSON.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODELO=gemini-2.5-flash-image
# Generaciones del modo realista por cliente por día (los intentos fallidos no cuentan).
PROBADOR_LIMITE_DIARIO=3
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\a\cuenta-servicio.json
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Compras digitales sin pagar: se anulan solas pasado este tiempo (libera el
# stock reservado y devuelve las prendas al carrito). La tarea corre dentro
# del backend cada TAREAS_INTERVALO_SEGUNDOS.
VENTA_PENDIENTE_MINUTOS=30
TAREAS_AUTOMATICAS=true
TAREAS_INTERVALO_SEGUNDOS=300

# Opcionales (tienen valor por defecto; en Railway no hace falta definirlos).
# Inicio de sesión: intentos fallidos por cuenta y ventana en segundos.
# LOGIN_MAX_INTENTOS=5
# LOGIN_VENTANA_SEGUNDOS=900
# Costo de bcrypt: 12 en producción (no lo cambies); solo las pruebas lo bajan a 4.
# BCRYPT_ROUNDS=12
# Días de vigencia de una suscripción nueva y plazo para devolver o cambiar prendas.
# SUSCRIPCION_DIAS_POR_DEFECTO=30
# PLAZO_CAMBIO_HORAS_RESPALDO=24
# Solicitud de cambio de talla o color del cliente: horas extra para APROBARLA tras el plazo (el cliente llega a la
# tienda después de pedirla; pasadas, la pendiente vence sola) y cuántas puede pedir una cuenta por ventana.
# SOLICITUD_CAMBIO_TOLERANCIA_HORAS=48
# SOLICITUD_CAMBIO_MAX_POR_VENTANA=5
# SOLICITUD_CAMBIO_VENTANA_SEGUNDOS=3600
# Días que se conserva la bitácora de auditoría (la purga la dispara un cron externo).
# BITACORA_RETENCION_DIAS=365
# Reportes con IA: tiempo máximo de Groq, reintentos y tope de filas.
# GROQ_TIMEOUT_SEGUNDOS=10
# GROQ_REINTENTOS=1
# REPORTES_IA_MAX_FILAS=500

# Solo para los scripts de datos iniciales (se definen en tu PowerShell, NO aquí):
#   SUPERADMIN_EMAIL, SUPERADMIN_PASSWORD (12+ caracteres) -> scripts.crear_superadmin
#   SEED_PASSWORD_INICIAL (8 a 72 caracteres)               -> scripts.seed_todo
# Guía completa: docs/despliegue_railway_vercel.md
